# Priyosha Charity Organization — environment template.
# Copy to .env (never commit .env) and fill in your real values:
#   cp .env.example .env
#
# DOMAIN is the public domain for the website, WITHOUT a scheme:
#   DOMAIN=priyoshacharity.com
# The values below are the live domain priyoshacharity.com — copy this
# file to .env and only change ADMIN_TOKEN and ENV for production.

# --- Domain / public URLs -----------------------------------------------
# Your domain, no https:// prefix. Used by Caddy (deploy/Caddyfile).
DOMAIN=priyoshacharity.com
# Full public URL of the website. Used as ALLOWED_ORIGIN and for the
# frontend's canonical URL (NEXT_PUBLIC_SITE_URL).
FRONTEND_URL=https://priyoshacharity.com
# Full public URL of the Go api-gateway, as the browser calls it.
# With Caddy this is https://api.<your domain> (see deploy/Caddyfile).
NEXT_PUBLIC_API_URL=https://api.priyoshacharity.com
NEXT_PUBLIC_SITE_URL=https://priyoshacharity.com

# --- Backend ------------------------------------------------------------
# ENV: development (default) or production. In production the gateway
# refuses to start if ALLOWED_ORIGIN is empty or "*".
ENV=development
# CORS origin — must be exactly your frontend URL in production.
# Local default if unset: http://localhost:3000
ALLOWED_ORIGIN=https://priyoshacharity.com
# Admin token for GET /api/pledges and GET /api/messages (X-Admin-Token
# header). Generate a long random value, e.g. `openssl rand -hex 32`,
# and share it only with the site owner. If empty, those GET endpoints
# always return 403. Never commit a real token.
ADMIN_TOKEN=
# Ports (defaults shown; change only if they clash on your server)
FRONTEND_PORT=3000
GATEWAY_PORT=8080
DONATION_PORT=8081
CONTACT_PORT=8082
CONTENT_PORT=8083
